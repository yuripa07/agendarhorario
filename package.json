{
  "name": "agendarhorario",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm run docker:dev:up && pnpm --parallel --filter @agendarhorario/api --filter @agendarhorario/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @agendarhorario/api test:e2e && pnpm --filter @agendarhorario/web test:e2e",
    "db:generate": "pnpm --filter @agendarhorario/api db:generate",
    "db:migrate": "pnpm --filter @agendarhorario/api db:migrate",
    "db:seed": "pnpm --filter @agendarhorario/api db:seed",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.27.12",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,md,css}": ["biome check --write"]
  }
}
