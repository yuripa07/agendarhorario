{
  "name": "agendarhorario",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @agendarhorario/shared build && pnpm run docker:dev:up && pnpm --parallel --filter @agendarhorario/api --filter @agendarhorario/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @agendarhorario/api test:e2e && pnpm --filter @agendarhorario/web test:e2e",
    "db:generate": "pnpm --filter @agendarhorario/api db:generate",
    "db:migrate": "pnpm --filter @agendarhorario/api db:migrate",
    "db:seed": "pnpm --filter @agendarhorario/api db:seed",
    "db:studio": "pnpm run docker:dev:up && DATABASE_URL=postgres://agendarhorario:agendarhorario@localhost:5432/agendarhorario pnpm --filter @agendarhorario/api db:studio",
    "db:studio:verbose": "pnpm run docker:dev:up && DATABASE_URL=postgres://agendarhorario:agendarhorario@localhost:5432/agendarhorario pnpm --filter @agendarhorario/api db:studio:verbose",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css}": [
      "biome check --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
