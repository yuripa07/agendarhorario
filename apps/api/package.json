{
  "name": "@agendarhorario/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @agendarhorario/shared build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @agendarhorario/shared build && vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "tenant:invite": "tsx src/tenancy/scripts/create-tenant-invite.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:verbose": "drizzle-kit studio --verbose"
  },
  "dependencies": {
    "@agendarhorario/shared": "workspace:*",
    "@better-auth/drizzle-adapter": "1.6.11",
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "@nestjs/throttler": "6.5.0",
    "@react-email/render": "2.0.8",
    "@thallesp/nestjs-better-auth": "2.6.0",
    "better-auth": "1.6.11",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.2",
    "helmet": "8.1.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "resend": "6.12.3",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/testing": "11.1.21",
    "@types/node": "25.8.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.0",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "tsx": "4.22.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
